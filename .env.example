# =============================================================================
# Helios Intelligence - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://helios_user:helios_password@localhost:5432/helios
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
LOG_LEVEL=INFO
DEBUG=false

# =============================================================================
# Object Storage Configuration
# =============================================================================
OBJECT_STORAGE_TYPE=local
OBJECT_STORAGE_PATH=./data/storage
# For S3-compatible storage (optional):
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=helios-data
# S3_ENDPOINT_URL=https://s3.amazonaws.com

# =============================================================================
# Time-series Database (Optional)
# =============================================================================
TSDB_TYPE=none
# TSDB_URL=influxdb://localhost:8086/helios
# TSDB_TOKEN=your_influxdb_token
# TSDB_ORG=helios

# =============================================================================
# Redis Configuration (Optional - for Celery)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# =============================================================================
# Fusion Algorithm Parameters
# =============================================================================
FUSION_ALPHA=0.5
FUSION_BETA=0.3
FUSION_GAMMA=0.2
Z_MAX=3.0
TIME_CONSTANT=300
NOISE_THRESHOLD=0.5
CONSISTENCY_WINDOW=3600
DELTA_R=0.1

# =============================================================================
# Physics Validation Configuration
# =============================================================================
PHYSICS_VALIDATION_ENABLED=true
PHYSICS_CONFIDENCE_MULTIPLIER_MIN=0.5
PHYSICS_AUTO_HARD_FAIL_BLOCK=true

# =============================================================================
# Satellite Data Ingestion Configuration
# =============================================================================
INGESTION_ENABLED=true
INGESTION_INTERVAL_SECONDS=60
DATA_RETENTION_DAYS=730

# Satellite-specific configurations
ADITYA_L1_ENABLED=true
ADITYA_L1_API_URL=https://aditya-data.isro.gov.in/api
ADITYA_L1_UPDATE_INTERVAL=300

SOHO_ENABLED=true
SOHO_API_URL=https://sohodata.nascom.nasa.gov/api
SOHO_UPDATE_INTERVAL=300

DSCOVR_ENABLED=true
DSCOVR_API_URL=https://satdat.ngdc.noaa.gov/api/dscovr
DSCOVR_UPDATE_INTERVAL=60

GOES_ENABLED=true
GOES_API_URL=https://data.ngdc.noaa.gov/api/goes
GOES_UPDATE_INTERVAL=60

ACE_ENABLED=true
ACE_API_URL=https://ace.sci.gsfc.nasa.gov/api
ACE_UPDATE_INTERVAL=300

WIND_ENABLED=true
WIND_API_URL=https://wind.nasa.gov/api
WIND_UPDATE_INTERVAL=300

# =============================================================================
# AI/ML Model Configuration
# =============================================================================
MODEL_PATH=./ai/models
DEVICE=cuda  # or 'cpu' for CPU inference
BATCH_SIZE=32
INFERENCE_THREADS=4

# Model versions
DETECTION_MODEL_VERSION=v1.0
PREDICTION_MODEL_VERSION=v1.0
UQ_MODEL_VERSION=v1.0

# =============================================================================
# Pipeline Configuration
# =============================================================================
PIPELINE_TRIGGER_TYPE=scheduled
PIPELINE_SCHEDULE=*/5 * * * *  # Every 5 minutes
PIPELINE_TIMEOUT_SECONDS=3600

# =============================================================================
# Decision Support Configuration
# =============================================================================
DSS_ENABLED=true
DSS_AUTOMATION_ENABLED=true
DSS_STAKEHOLDERS=satellite_ops,power_grid,astronauts,ground_station,scientist_review

# =============================================================================
# Security Configuration
# =============================================================================
SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_KEY_HEADER=X-API-Key

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# =============================================================================
# Monitoring Configuration (Optional)
# =============================================================================
METRICS_ENABLED=false
METRICS_PORT=9090
PROMETHEUS_MULTIPROC_DIR=/tmp

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_FORMAT=json
LOG_ROTATION=500 MB
LOG_RETENTION=30 days
LOG_FILE=./logs/helios.log

# =============================================================================
# Testing Configuration
# =============================================================================
TEST_DATABASE_URL=postgresql://helios_test:helios_test@localhost:5432/helios_test
TEST_DATA_PATH=./tests/data

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_EXPLAINABILITY_ENABLED=true
FEATURE_UQ_ENABLED=true
FEATURE_CONSENSUS_ENABLED=true
FEATURE_PHYSICS_VALIDATION_ENABLED=true
FEATURE_DSS_ENABLED=true
FEATURE_DASHBOARD_ENABLED=true
